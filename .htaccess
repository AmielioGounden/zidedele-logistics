# Zidedele Logistics Solutions - production .htaccess
# Developer original reviewed and hardened by TSA Online, 17 Nov 2026

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ServerSignature Off

<IfModule mod_rewrite.c>
RewriteEngine On

# Block TRACE/TRACK
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
RewriteRule ^ - [F]

# Leave AutoSSL / domain validation alone
RewriteRule ^\.well-known/ - [L]

# Force HTTPS. X-Forwarded-Proto is checked because nginx (Engintron) sits in front of Apache.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.zidedele.co.za%{REQUEST_URI} [R=301,L,NE]

# Canonical host: www.zidedele.co.za
RewriteCond %{HTTP_HOST} !^www\.zidedele\.co\.za$ [NC]
RewriteRule ^ https://www.zidedele.co.za%{REQUEST_URI} [R=301,L,NE]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ https://www.zidedele.co.za/ [R=301,L]

# Direct .html requests -> clean URLs
RewriteCond %{THE_REQUEST} \s/+(about|supply-chain|fleet-facilities|contact|website-disclaimer|privacy-policy)\.html[?\s] [NC]
RewriteRule ^ https://www.zidedele.co.za/%1 [R=301,L]

# Trailing slash on page URLs -> no trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(about|supply-chain|fleet-facilities|contact|website-disclaimer|privacy-policy)/$ https://www.zidedele.co.za/$1 [R=301,L]

# Serve the matching .html file for clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]
</IfModule>

# TSA requirement: disable mod_pagespeed.
<IfModule pagespeed_module>
ModPagespeed off
</IfModule>
<IfModule mod_headers.c>
Header set PageSpeed off
RequestHeader set PageSpeed off
</IfModule>

<IfModule mod_headers.c>
# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>

# Block documentation, examples, dotfiles, config and backup files
<FilesMatch "(^\.(?!well-known)|\.(md|log|ini|bak|old|orig|sql|sh|zip|tar|gz|dist|example\.php)$|^(composer\.(json|lock)|package(-lock)?\.json)$|mail-config.*\.php$)">
Require all denied
</FilesMatch>

# The only PHP file that may be run is the enquiry handler
<FilesMatch "\.(php|phtml|phar)$">
Require all denied
</FilesMatch>
<Files "send-enquiry.php">
Require all granted
</Files>

# Gzip compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/markdown
AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/ld+json
AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching (CSS/JS are versioned with ?v= so they can be cached long)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType application/xml "access plus 1 day"
ExpiresByType text/plain "access plus 1 day"
ExpiresDefault "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<Files "send-enquiry.php">
Header always set Cache-Control "no-store"
Header always set X-Robots-Tag "noindex, nofollow"
</Files>
</IfModule>

<IfModule mod_mime.c>
AddType text/plain .txt
AddCharset utf-8 .html .css .js .txt .xml
</IfModule>
